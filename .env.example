# OpenAI API Key (only needed if you use --provider openai)
OPENAI_API_KEY=<redacted>

# Optional: Specify OpenAI base URL if using a custom endpoint
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Ollama (local open-weight models) — used with --provider ollama (default)
# Default model is Gemma 3 (open-weight). Change to any model you pulled with Ollama,
# e.g. llama3.2, qwen2.5, mistral
OLLAMA_MODEL=gemma3

# Ollama server address (default is your local machine)
# OLLAMA_BASE_URL="http://localhost:11434/v1"
